import assert from 'node:assert/strict';
import { after, before, test } from 'node:test';
import type { Server } from 'node:http';
import { call, field, start } from './helpers.ts';

let base = '';
let server: Server | undefined;
before(async () => ({ base, server } = await start()));
after(() => server?.close());

const MISSING = '00000000-0000-4000-8000-000000000000';

test('POST creates a user, GET fetches it', async () => {
  const created = await call(base, 'POST', '/v1/users', { name: 'Ada', email: 'ada@example.com', age: 36 }, 'key-create-1');
  assert.equal(created.status, 201);
  const id = field(created.json, 'id');
  assert.equal(typeof id, 'string');
  assert.equal(field(created.json, 'email'), 'ada@example.com');
  const got = await call(base, 'GET', `/v1/users/${String(id)}`);
  assert.equal(got.status, 200);
  assert.equal(field(got.json, 'name'), 'Ada');
});

test('POST with duplicate email returns 409 problem+json', async () => {
  await call(base, 'POST', '/v1/users', { name: 'Dup', email: 'dup@example.com' }, 'key-dup-001');
  const res = await call(base, 'POST', '/v1/users', { name: 'Dup2', email: 'dup@example.com' }, 'key-dup-002');
  assert.equal(res.status, 409);
  assert.equal(res.type, 'application/problem+json');
});

test('POST with invalid email returns 422 problem+json', async () => {
  const res = await call(base, 'POST', '/v1/users', { name: 'Bad', email: 'not-an-email' }, 'key-bad-001');
  assert.equal(res.status, 422);
  assert.equal(res.type, 'application/problem+json');
});

test('POST with out-of-range age returns 422', async () => {
  const res = await call(base, 'POST', '/v1/users', { name: 'Old', email: 'old@example.com', age: 151 }, 'key-old-001');
  assert.equal(res.status, 422);
});

test('GET /v1/users pages with an opaque cursor', async () => {
  for (let i = 0; i < 3; i++) {
    await call(base, 'POST', '/v1/users', { name: `P${i}`, email: `page${i}@example.com` }, `key-page-${i}0000`);
  }
  const first = await call(base, 'GET', '/v1/users?limit=2');
  assert.equal(first.status, 200);
  const data = field(first.json, 'data');
  assert.ok(Array.isArray(data));
  assert.equal(data.length, 2);
  const next = field(first.json, 'nextCursor');
  assert.equal(typeof next, 'string');
  const second = await call(base, 'GET', `/v1/users?limit=2&cursor=${encodeURIComponent(String(next))}`);
  assert.equal(second.status, 200);
  const data2 = field(second.json, 'data');
  assert.ok(Array.isArray(data2));
  assert.ok(data2.length >= 1);
});

test('PATCH updates a user, and rejects duplicate email', async () => {
  const a = await call(base, 'POST', '/v1/users', { name: 'A', email: 'pa@example.com' }, 'key-patch-a1');
  await call(base, 'POST', '/v1/users', { name: 'B', email: 'pb@example.com' }, 'key-patch-b1');
  const id = String(field(a.json, 'id'));
  const ok = await call(base, 'PATCH', `/v1/users/${id}`, { name: 'A2' });
  assert.equal(ok.status, 200);
  assert.equal(field(ok.json, 'name'), 'A2');
  const dup = await call(base, 'PATCH', `/v1/users/${id}`, { email: 'pb@example.com' });
  assert.equal(dup.status, 409);
  assert.equal(dup.type, 'application/problem+json');
  const missing = await call(base, 'PATCH', `/v1/users/${MISSING}`, { name: 'x' });
  assert.equal(missing.status, 404);
});

test('DELETE returns 204, then GET returns 404', async () => {
  const c = await call(base, 'POST', '/v1/users', { name: 'Del', email: 'del@example.com' }, 'key-del-0001');
  const id = String(field(c.json, 'id'));
  const del = await call(base, 'DELETE', `/v1/users/${id}`);
  assert.equal(del.status, 204);
  const got = await call(base, 'GET', `/v1/users/${id}`);
  assert.equal(got.status, 404);
  assert.equal(got.type, 'application/problem+json');
});
